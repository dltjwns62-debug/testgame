{
  "openapi": "3.0.3",
  "info": {
    "title": "Test Game Online Readiness API",
    "version": "1.0.0",
    "description": "Contract only. No real server URL, authentication provider, or deployed service is included in Stage 17."
  },
  "servers": [],
  "paths": {
    "/v1/health": { "get": { "responses": { "200": { "description": "Health response" } } } },
    "/v1/session/bootstrap": { "post": { "requestBody": { "$ref": "#/components/requestBodies/BootstrapRequest" }, "responses": { "200": { "description": "Session bootstrap" }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" } } } },
    "/v1/sync/pull": { "post": { "requestBody": { "$ref": "#/components/requestBodies/PullRequest" }, "responses": { "200": { "description": "Snapshot pull" }, "409": { "$ref": "#/components/responses/ConflictError" } } } },
    "/v1/sync/push": { "post": { "requestBody": { "$ref": "#/components/requestBodies/PushRequest" }, "responses": { "200": { "description": "Operation acknowledgement" }, "409": { "$ref": "#/components/responses/ConflictError" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "429": { "$ref": "#/components/responses/RateLimitError" } } } },
    "/v1/battles/submit": { "post": { "requestBody": { "$ref": "#/components/requestBodies/OperationRequest" }, "responses": { "202": { "description": "Battle submission accepted for server validation" }, "400": { "$ref": "#/components/responses/ValidationError" } } } },
    "/v1/offline/claim": { "post": { "requestBody": { "$ref": "#/components/requestBodies/OperationRequest" }, "responses": { "202": { "description": "Offline claim accepted for server validation" }, "409": { "$ref": "#/components/responses/ConflictError" } } } }
  },
  "components": {
    "requestBodies": {
      "BootstrapRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapRequest" } } } },
      "PullRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PullRequest" } } } },
      "PushRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushRequest" } } } },
      "OperationRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Operation" } } } }
    },
    "responses": {
      "ValidationError": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "AuthError": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ConflictError": { "description": "Server revision conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "PayloadTooLarge": { "description": "Payload too large" },
      "RateLimitError": { "description": "Rate limited" }
    },
    "schemas": {
      "BootstrapRequest": { "type": "object", "required": ["protocolVersion", "deviceId", "clientInstanceId"], "properties": { "protocolVersion": { "type": "integer", "const": 1 }, "deviceId": { "type": "string" }, "clientInstanceId": { "type": "string" }, "snapshot": { "type": "object" } } },
      "PullRequest": { "type": "object", "required": ["protocolVersion", "expectedServerRevision"], "properties": { "protocolVersion": { "type": "integer", "const": 1 }, "expectedServerRevision": { "type": "integer", "minimum": 0 } } },
      "PushRequest": { "type": "object", "required": ["protocolVersion", "expectedServerRevision", "operations"], "properties": { "protocolVersion": { "type": "integer", "const": 1 }, "expectedServerRevision": { "type": "integer", "minimum": 0 }, "operations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Operation" } } } },
      "Operation": { "type": "object", "required": ["protocolVersion", "operationId", "deviceId", "clientInstanceId", "createdAtMs", "baseServerRevision", "type", "payloadHash", "payload"], "properties": { "protocolVersion": { "type": "integer", "const": 1 }, "operationId": { "type": "string" }, "deviceId": { "type": "string" }, "clientInstanceId": { "type": "string" }, "createdAtMs": { "type": "integer", "minimum": 0 }, "baseServerRevision": { "type": "integer", "minimum": 0 }, "type": { "type": "string" }, "payloadHash": { "type": "string" }, "payload": {} } },
      "Error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "serverRevision": { "type": "integer", "minimum": 0 } } }
    }
  }
}
