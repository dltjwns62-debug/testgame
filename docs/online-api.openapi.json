{
  "openapi": "3.0.3",
  "info": {
    "title": "Test Game Online Readiness API",
    "version": "1.0.0",
    "description": "Contract only. Stage 17 does not include a real server, URL, authentication provider, or deployed service. Idempotency-Key is required for sync pull/push, battle submit, and offline claim; bootstrap is intentionally session-creation only and does not require it."
  },
  "servers": [],
  "paths": {
    "/v1/health": {
      "get": {
        "responses": { "200": { "description": "Health response", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } } } }
      }
    },
    "/v1/session/bootstrap": {
      "post": {
        "requestBody": { "$ref": "#/components/requestBodies/BootstrapRequest" },
        "responses": { "200": { "description": "Session bootstrap", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapResponse" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" }, "500": { "$ref": "#/components/responses/ServerError" } }
      }
    },
    "/v1/sync/pull": {
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/PullRequest" },
        "responses": { "200": { "description": "Snapshot pull", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PullSnapshotResponse" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" }, "409": { "$ref": "#/components/responses/ConflictError" }, "429": { "$ref": "#/components/responses/RateLimitError" }, "500": { "$ref": "#/components/responses/ServerError" } }
      }
    },
    "/v1/sync/push": {
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/PushRequest" },
        "responses": { "200": { "description": "Operation acknowledgement", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushOperationsResponse" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" }, "409": { "$ref": "#/components/responses/ConflictError" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "429": { "$ref": "#/components/responses/RateLimitError" }, "500": { "$ref": "#/components/responses/ServerError" } }
      }
    },
    "/v1/battles/submit": {
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/OperationRequest" },
        "responses": { "202": { "description": "Battle submission accepted for server validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationAcceptedResponse" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" }, "409": { "$ref": "#/components/responses/ConflictError" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "429": { "$ref": "#/components/responses/RateLimitError" }, "500": { "$ref": "#/components/responses/ServerError" } }
      }
    },
    "/v1/offline/claim": {
      "post": {
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "$ref": "#/components/requestBodies/OperationRequest" },
        "responses": { "202": { "description": "Offline claim accepted for server validation", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OperationAcceptedResponse" } } } }, "400": { "$ref": "#/components/responses/ValidationError" }, "401": { "$ref": "#/components/responses/AuthError" }, "409": { "$ref": "#/components/responses/ConflictError" }, "413": { "$ref": "#/components/responses/PayloadTooLarge" }, "429": { "$ref": "#/components/responses/RateLimitError" }, "500": { "$ref": "#/components/responses/ServerError" } }
      }
    }
  },
  "components": {
    "parameters": {
      "IdempotencyKey": { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 128 } }
    },
    "requestBodies": {
      "BootstrapRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BootstrapRequest" } } } },
      "PullRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PullRequest" } } } },
      "PushRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PushRequest" } } } },
      "OperationRequest": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Operation" } } } }
    },
    "responses": {
      "ValidationError": { "description": "Validation failed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "AuthError": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ConflictError": { "description": "Server revision conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "PayloadTooLarge": { "description": "Payload too large", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "RateLimitError": { "description": "Rate limited", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 0 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
      "ServerError": { "description": "Server error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
    },
    "schemas": {
      "HealthResponse": { "type": "object", "required": ["protocolVersion", "status"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "status": { "type": "string" } } },
      "BootstrapRequest": { "type": "object", "required": ["protocolVersion", "deviceId", "clientInstanceId"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "deviceId": { "type": "string" }, "clientInstanceId": { "type": "string" }, "accountId": { "type": "string", "nullable": true }, "snapshot": { "type": "object", "nullable": true } } },
      "BootstrapResponse": { "type": "object", "required": ["protocolVersion", "sessionId", "accountId", "serverRevision", "snapshot"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "sessionId": { "type": "string" }, "accountId": { "type": "string", "nullable": true }, "serverRevision": { "type": "integer", "minimum": 0 }, "snapshot": { "type": "object", "nullable": true } } },
      "PullRequest": { "type": "object", "required": ["protocolVersion", "expectedServerRevision"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "sessionId": { "type": "string", "nullable": true }, "expectedServerRevision": { "type": "integer", "minimum": 0, "nullable": true } } },
      "PullSnapshotResponse": { "type": "object", "required": ["protocolVersion", "serverRevision", "snapshot"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "serverRevision": { "type": "integer", "minimum": 0 }, "snapshot": { "type": "object", "nullable": true } } },
      "PushRequest": { "type": "object", "required": ["protocolVersion", "expectedServerRevision", "operations"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "sessionId": { "type": "string", "nullable": true }, "expectedServerRevision": { "type": "integer", "minimum": 0 }, "operations": { "type": "array", "maxItems": 200, "items": { "$ref": "#/components/schemas/Operation" } } } },
      "PushOperationsResponse": { "type": "object", "required": ["protocolVersion", "serverRevision", "acknowledgedOperationIds", "duplicateOperationIds", "rejectedOperationIds", "rejectedReasons", "snapshot"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "serverRevision": { "type": "integer", "minimum": 0 }, "acknowledgedOperationIds": { "type": "array", "items": { "type": "string" } }, "duplicateOperationIds": { "type": "array", "items": { "type": "string" } }, "rejectedOperationIds": { "type": "array", "items": { "type": "string" } }, "rejectedReasons": { "type": "object", "additionalProperties": { "$ref": "#/components/schemas/ErrorResponse" } }, "snapshot": { "type": "object", "nullable": true } } },
      "OperationAcceptedResponse": { "type": "object", "required": ["protocolVersion", "operationId", "accepted"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "operationId": { "type": "string" }, "accepted": { "type": "boolean" }, "serverRevision": { "type": "integer", "minimum": 0 } } },
      "Operation": { "type": "object", "required": ["protocolVersion", "operationId", "deviceId", "clientInstanceId", "createdAtMs", "baseServerRevision", "type", "payloadHash", "payload"], "properties": { "protocolVersion": { "type": "integer", "enum": [1] }, "operationId": { "type": "string", "minLength": 1, "maxLength": 128 }, "deviceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "clientInstanceId": { "type": "string", "minLength": 1, "maxLength": 128 }, "createdAtMs": { "type": "integer", "minimum": 0 }, "baseServerRevision": { "type": "integer", "minimum": 0 }, "type": { "type": "string" }, "payloadHash": { "type": "string" }, "payload": {} } },
      "ErrorResponse": { "type": "object", "required": ["code", "message", "retryable"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "retryable": { "type": "boolean" }, "serverRevision": { "type": "integer", "minimum": 0 }, "retryAfterMs": { "type": "integer", "minimum": 0 } } }
    }
  }
}
